# ============================================
# VAULTIS BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in all values
# NEVER commit .env file to version control
# Generate secrets with: openssl rand -base64 32
# ============================================

# SERVER CONFIGURATION
# ====================
# Port for Express server (Vercel overrides this)
PORT=5000

# Environment: development, staging, production
NODE_ENV=development

# MONGODB CONNECTION
# ==================
# CRITICAL: Use MongoDB Atlas for production (not local MongoDB)
# Connection string format:
#   mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# For local development:
#   mongodb://127.0.0.1:27017/vaultis
MONGODB_URI=mongodb://127.0.0.1:27017/vaultis

# JWT AUTHENTICATION
# ==================
# Secret key for signing JWT tokens
# Generate with: openssl rand -base64 32
# MUST be different for production
JWT_SECRET=replace_with_32_character_random_secret_string_here

# Token expiration time
JWT_EXPIRES_IN=7d

# ENCRYPTION
# ==========
# AES-256-GCM encryption key (must be exactly 32 hex characters = 16 bytes)
# Generate with: openssl rand -hex 16
# Example output: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
ENCRYPTION_KEY=replace_with_32_char_encryption_key

# EMAIL CONFIGURATION
# ===================
# CRITICAL: Use Gmail app-specific passwords (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-specific-password

# FRONTEND INTEGRATION
# ====================
# Frontend URL for CORS configuration
# Development: http://localhost:5173
# Production: https://your-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# Publicly reachable base URL of THIS backend (used to build email links that hit
# backend API routes directly, e.g. trusted-contact confirmation links)
BACKEND_URL=http://localhost:5000

# Set to true to allow unlimited /api/checkin requests (demo mode only — do not
# enable in a real production deployment)
CHECKIN_DEMO_MODE=false

# BLOCKCHAIN CONFIGURATION
# ========================
# Network: Ethereum Sepolia Testnet
# Chain ID: 11155111

# RPC endpoint for Sepolia testnet
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Etherscan API key for transaction verification and contract interaction
# Get from: https://sepolia.etherscan.io/apis
ETHERSCAN_API_KEY=your-etherscan-api-key

# Private key for deployer wallet (hex format, no 0x prefix)
# CRITICAL: Never share this key
# Generate a new testnet wallet at: https://www.mycrypto.com/create-wallet
DEPLOYER_PRIVATE_KEY=replace_with_64_hex_character_private_key

# Deployed contract addresses
# LVT Token address on Sepolia
VAULTIS_TOKEN_ADDRESS=0x9BD654624D490DeBA2fEF53D959ab27e29373A77

# Optional contract addresses (if deployed)
WILL_REGISTRY_ADDRESS=
INHERITANCE_TRIGGER_ADDRESS=

# AWS S3 DOCUMENT STORAGE (OPTIONAL)
# ===================================
# Off by default — the app stores encrypted will/asset content in MongoDB unless
# this is enabled. When enabled, encrypted (already AES-256-GCM) blobs are
# uploaded to S3 instead, and only a reference is kept in MongoDB.
AWS_S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# IPFS/PINATA INTEGRATION (OPTIONAL)
# ===================================
# For decentralized document storage
# Get credentials from: https://www.pinata.cloud

# Pinata JWT token for authentication
PINATA_JWT=

# Pinata API credentials
PINATA_API_KEY=
PINATA_API_SECRET=

# CRON JOBS
# =========
# Schedule for automated tasks (heartbeat checks, reminders, etc.)
# Format: minute hour day month weekday
# Examples:
#   0 0 * * *     = Daily at midnight
#   0 8 * * MON   = Every Monday at 8am
#   */15 * * * *  = Every 15 minutes
# Only used when running as a long-lived server (not on Vercel — see CRON_SECRET below)
CRON_SCHEDULE=0 0 * * *

# On Vercel, node-cron can't persist between requests, so the dead-man-switch
# job instead runs via GET /api/cron/run, invoked on a schedule by Vercel Cron
# (see backend/vercel.json). Set this to a random secret; Vercel Cron
# automatically sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
# Required in production — the endpoint refuses to run without it.
CRON_SECRET=

# ADDITIONAL SECURITY SETTINGS (Auto-configured, do not modify)
# ==============================================================
# Rate limiting: 100 requests per 15 minutes per IP
# Check-in unlimited (demo mode)
# CORS: Restricted to FRONTEND_URL
# Headers: Helmet security headers enabled
# Input sanitization: XSS and NoSQL injection protection
# Password requirements: minimum 12 characters with complexity
