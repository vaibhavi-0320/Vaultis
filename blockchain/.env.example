# RPC endpoint for Sepolia testnet
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key for the deployer wallet (hex format, no 0x prefix)
# CRITICAL: Never commit this. Use a dedicated testnet-only wallet.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used for contract verification after deploy
ETHERSCAN_API_KEY=
